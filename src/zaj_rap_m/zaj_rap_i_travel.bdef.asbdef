managed;
strict ( 2 );

define behavior for ZAJ_RAP_I_TRAVEL //alias Travel
implementation in class zcl_bp_aj_rap_i_travel unique
persistent table zaj_rap_travel_m
lock master
authorization master ( instance )
etag master LastChangedAt
{
  create ( authorization : global );
  update;
  delete;
  //field ( readonly ) TravelId;
  association _Booking { create; }
  mapping for zaj_rap_travel_m
    {
      TravelId      = travel_id;
      AgencyId      = agency_id;
      CustomerId    = customer_id;
      BeginDate     = begin_date;
      EndDate       = end_date;
      BookingFee    = booking_fee;
      TotalPrice    = total_price;
      CurrencyCode  = currency_code;
      Description   = description;
      OverallStatus = overall_status;
      CreatedBy     = created_by;
      CreatedAt     = created_at;
      LastChangedBy = last_changed_by;
      LastChangedAt = last_changed_at;
    }
}

define behavior for ZAJ_RAP_I_BOOKING //alias <alias_name>
implementation in class zcl_bp_aj_rap_i_booking unique
persistent table zaj_rap_bookin_m
lock dependent by _Travel
authorization dependent by _Travel
etag master LastChangedAt
{
  update;
  delete;
  field ( readonly ) TravelId;
  //BookingId;
  association _Travel;
  association _BookingSuppl { create; }
  mapping for zaj_rap_bookin_m
    {
      TravelId      = travel_id;
      BookingId     = booking_id;
      BookingDate   = booking_date;
      CustomerId    = customer_id;
      CarrierId     = carrier_id;
      ConnectionId  = connection_id;
      FlightDate    = flight_date;
      FlightPrice   = flight_price;
      CurrencyCode  = currency_code;
      BookingStatus = booking_status;
      LastChangedAt = last_changed_at;
    }
}

define behavior for Zaj_RAP_I_BSUPPL_M //alias <alias_name>
implementation in class zcl_bp_aj_rap_i_bsuppl unique
persistent table zaj_rap_bsuppl_m
lock dependent by _Travel
authorization dependent by _Travel
etag master LastChangedAt
{
  update;
  delete;
  field ( readonly ) TravelId, BookingId;
  //BookingSupplementId;
  association _Travel;
  association _Booking;
  mapping for zaj_rap_bsuppl_m
    {
      TravelId            = travel_id;
      BookingId           = booking_id;
      BookingSupplementId = booking_supplement_id;
      SupplementId        = supplement_id;
      Price               = price;
      CurrencyCode        = currency_code;
      LastChangedAt       = last_changed_at;
    }
}